%YAML 1.2
---
name: MDITA Markdown
scope: text.html.markdown.mdita
version: 2
file_extensions:
  - md
  - markdown
  - mdita
  - mditamap
extends: Packages/Markdown/Markdown.sublime-syntax

contexts:
  inlines:
    - meta_prepend: true
    - match: '\{(?=[^}]*\})'
      scope: punctuation.definition.attributes.begin.mdita
      push: inline-attribute
  inline-attribute:
    - meta_scope: meta.attributes.mdita
    - match: '\}'
      scope: punctuation.definition.attributes.end.mdita
      pop: 1

  # Definition lists: a one-line term followed by `:   description`.
  # A term is only known once the next line starts with `:`. The line is
  # tried as a paragraph first, which fails over to a term at that `:`.
  # Trying the paragraph first keeps a one-line paragraph at the end of the
  # file a paragraph, because a branch still open at EOF keeps its choice.
  markdown:
    - meta_prepend: true
    - include: definition-descriptions

  setext-headings-or-paragraphs:
    - match: '{{setext_heading_or_paragraph}}'
      branch_point: setext-headings-or-paragraphs
      branch:
        - paragraph-first-line
        - definition-term
        - setext-heading2
        - setext-heading1

  paragraph-first-line:
    - meta_scope: meta.paragraph.markdown
    - match: '\n'
      set: paragraph-second-line
    - include: paragraph-end
    - include: math-blocks
    - include: inlines

  paragraph-second-line:
    - meta_scope: meta.paragraph.markdown
    - match: '^(?=:[ \t])'
      fail: setext-headings-or-paragraphs
    - include: paragraph-fail
    - include: paragraph-end
    - match: '^'
      set: paragraph

  definition-term:
    - meta_scope: meta.definition.term.mdita
    - meta_content_scope: entity.name.definition.mdita
    - match: '\n'
      set: definition-term-end
    - include: inlines

  definition-term-end:
    - match: '^(?=:[ \t])'
      pop: 1
    - match: '^'
      fail: setext-headings-or-paragraphs

  definition-descriptions:
    - match: '^(:)[ \t]+'
      captures:
        1: markup.list.definition.bullet.mdita punctuation.definition.list_item.markdown
      push: definition-description

  definition-description:
    - meta_content_scope: markup.list.definition.mdita
    - include: list-block-end
    - include: list-block-content

  # `terminal` is the info string that AEM DITA uses for shell sessions.
  # Highlight it like `console`: a `$` prompt marks commands, and other
  # lines are output.
  fenced-code-block-body:
    - meta_prepend: true
    - match: |-
        (?xi)
        [ \t]*
        (terminal)
        {{fenced_code_block_language_break}}
      captures:
        1: constant.other.language-name.markdown
      push:
        - fenced-code-block-bash-content
        - fenced-code-block-infostring

  # A `[Title]` line directly after the last table row is the table title,
  # which the plug-in builds as <table><title>. It ends the table.
  table-body:
    - meta_prepend: true
    - match: ^[ \t]*((\[)([^\]]*)(\]))[ \t]*\n
      captures:
        1: meta.table.caption.mdita
        2: punctuation.definition.caption.begin.mdita
        3: markup.caption.mdita
        4: punctuation.definition.caption.end.mdita
      pop: 1
